# Copia este archivo a .env.local y completa los valores. .env.local NO se sube a git.

# --- PayPal (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Se obtiene al registrar la URL del webhook en el panel de PayPal
PAYPAL_WEBHOOK_ID=
# El client id es público: lo usa el botón de PayPal en el navegador
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Groq (console.groq.com > API Keys) ---
GROQ_API_KEY=
# Opcionales: Groq cambia su catálogo; verifica en console.groq.com/docs/models
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_SPEECH_MODEL=whisper-large-v3-turbo

# --- Supabase (supabase.com > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: solo servidor. Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
